    /**
     * 返回 key（中文原文）在当前语言下的翻译。
     * @param key - 中文原文
     * @param currentLang - settingsController.language，用于创建绑定依赖
     */
    function t(key, currentLang) {
        return currentLang === "English" ? (_dict[key] || key) : key;
    }
